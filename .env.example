# Backend API konfiguratsiyasi — nusxa oling: cp .env.example .env
# .env ni git'ga QO'SHMANG (parol bor).

# PostgreSQL DSN (parol bilan to'liq). ETL ham shu o'zgaruvchini o'qiydi.
XT_DB_DSN=dbname=xtxarid user=a1234 password=SIZNING_PAROLINGIZ host=localhost port=5432

# Connection pool o'lchamlari
DB_POOL_MIN=1
DB_POOL_MAX=8

# ILOVA ROLI — ulanish OCHILGACH shu rolga tushiladi.
#
# NEGA KERAK. Ishlab chiqishda `XT_DB_DSN` ko'pincha `postgres`
# (superuser) bo'ladi. Superuser HAMMA grant tekshiruvini chetlab
# o'tadi, ya'ni ERP chegarasi va IDOR himoyalari SINALMAY qoladi.
# Farq o'lchangan (2026-09-06): `auth_test` superuser bilan 10 ta
# tekshiruv beradi, `tai_app` bilan 131 ta.
#
# Ishlab chiqarishda BU QATOR KERAK EMAS: u yerda DSN allaqachon
# `tai_service` bilan ulanadi va u `tai_app` a'zosi
# (docs/deploy.md §6). Bu qator faqat superuser DSN bilan
# ishlaydigan mashinada rejimni to'g'rilaydi.
#
# `run_tests.py` buni O'ZI ham qo'yadi, lekin yakka sinov
# yurgizganda (`python _tests/auth_test.py`) u chaqirilmaydi.
DB_SET_ROLE=tai_app

# AI tahlil (5a bosqich) — console.anthropic.com > API Keys
# Faqat backendда o'qiladi, frontendga HECH QACHON chiqmaydi.
# Kalitsiz ham dashboard to'liq ishlaydi — AI bo'limi ko'rinmaydi, xolos.
ANTHROPIC_API_KEY=
# Tahlil chuqurligi: low | medium | high  (standart: medium)
AI_EFFORT=medium

# --- AI-CHAT (J4) ---------------------------------------------------------
# Model: interaktiv, kechikish muhim. Chuqur tahlil `run_gonogo` tool'i
# orqali Opus 5 ga o'tadi.
AI_CHAT_MODEL=claude-sonnet-5
AI_CHAT_EFFORT=medium
AI_CHAT_MAX_TOKENS=4000
# Agentik tsikl chegarasi - cheksiz tool tsikli = cheksiz hisob
AI_CHAT_MAX_ROUNDS=6
# Tarixdagi xabarlar soni. Kontekst 1M bo'lsa ham har navbatda to'liq
# tarix yuborish qimmat.
AI_CHAT_HISTORY=20

# --- EMBEDDING (J2) -------------------------------------------------------
# `local` = server ichida (hujjat TASHQARIGA CHIQMAYDI), `voyage` = API.
EMBED_PROVIDER=local
# O'LCHANGAN (4 CPU ipi, GPU'siz, ~460 token):
#   intfloat/multilingual-e5-small  118M ·  384 o'lcham · 0.17 s/bo'lak
#   voyageai/voyage-4-nano          344M · 1024 o'lcham · 8.9  s/bo'lak
# Modelni almashtirsangiz `schema_patch_embed_384.sql` uslubida ustun
# turini ham o'zgartiring - `embed_model.dims` bilan MOS bo'lishi shart.
EMBED_MODEL_PATH=intfloat/multilingual-e5-small
# O'RTA SERVER: torch standart holda BARCHA yadroni oladi va API javob
# bera olmay qoladi. 0 = cheklamaslik.
EMBED_THREADS=4
# Modelni START da fon ipida yuklash. O'lchangan: yuklanish ~17 s,
# keyingi har so'rov 19-54 ms. Isitmasak BIRINCHI chat savoli 17
# soniya kutadi. 0 = yuklamaslik (~470 MB xotira tejaladi; chat
# ishlatilmaydigan o'rnatish uchun).
EMBED_PRELOAD=1
EMBED_BATCH=32
# Model matnni shu uzunlikkacha TO'LDIRADI - katta qiymat sekinlashtiradi.
EMBED_MAX_SEQ=512
# Bo'lak hajmi va ustma-ustlik (belgi). Ustma-ustlik chegarada kesilgan
# jumla yo'qolmasligi uchun.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- MUHIT va OMMAVIY MANZIL ---
# Muhit nomi: dev | staging | production. `dev` da mahalliy manzillarga
# ruxsat; staging/production da MAHALLIY MANZIL RAD ETILADI.
APP_ENV=dev

# Bildirishnoma havolalari (email, Telegram) shundan quriladi —
# `api/ommaviy_url.py`, YAGONA manba.
#
# `dev` da BO'SH qoldirsangiz `http://localhost:5173` ishlatiladi.
# `staging`/`production` da BERILISHI SHART: busiz xizmat UMUMAN
# ishga tushmaydi (`ommaviy_url.ishga_tushishda_tekshir()`).
#
# Eski nom `PUBLIC_BASE_URL` hali ishlaydi, lekin ogohlantirish
# yozadi; ikkalasi boshqa qiymat bilan berilsa — xato.
APP_PUBLIC_URL=

# CORS — frontend ulanganда yoqing (vergul bilan ajratilgan originlar yoki *)
# React (Vite) dev-server odatda :5173 da ishlaydi.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API server (uvicorn) manzili — faqat qulaylik uchun eslatma
# ishga tushirish: .venv/bin/uvicorn api.main:app --reload --port 8000

# Email bildirishnoma (P0-10) — PLATFORMANING pochta serveri.
#
# DIQQAT — BU FOYDALANUVCHI SOZLAMASI EMAS. Foydalanuvchi interfeysда faqat
# O'Z EMAILINI yozadi; xabarni platformaning o'zi shu server orqali yuboradi.
# Host/port/login — operatorning infratuzilma detali, u interfeysга chiqmaydi.
#
# Bo'sh bo'lsa tizim ANIQ xato beradi ("Platformaning pochta serveri
# sozlanmagan"), jimgina "yuborildi" demaydi.
#
# Gmail uchun oddiy parol emas, "App password" kerak.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Jo'natuvchi manzil. Bo'sh bo'lsa SMTP_USER ishlatiladi.
SMTP_FROM=
# STARTTLS (587-port uchun). 465-portда SSL avtomatik. O'chirish: SMTP_TLS=0
SMTP_TLS=1

# Telegram bildirishnoma (P0-10, ikkinchi kanal) — BOT TOKENI.
# Qayerdan olinadi: Telegramда @BotFather > /newbot (yoki /mybots > API Token).
# DIQQAT: token BAZADA SAQLANMAYDI — `notify_settings` da faqat
# `telegram_enabled` va `telegram_chat_id` turadi. Token bilan botni TO'LIQ
# boshqarish mumkin, baza dumpi esa ko'p qo'ldan o'tadi.
# Bo'sh bo'lsa Telegram kanalini yoqib bo'lmaydi — tizim ANIQ xato beradi.
#
# CHAT ID QO'LDA KIRITILMAYDI. Interfeysда "Telegramni ulash" tugmasi bir
# martalik havola beradi (https://t.me/<bot>?start=<token>); foydalanuvchi uni
# bosadi va bot tokenni oladi. FAQAT shu token bilan kelgan suhbat ulanadi —
# tokensiz /start bosgan begona odam obunachi BO'LMAYDI.
#
# Baza patchlari (bir marta, shu tartibda):
#   psql ... -f schema_patch_notify_telegram.sql
#   psql ... -f schema_patch_notify_subscribers.sql
#   psql ... -f schema_patch_notify_link.sql
TELEGRAM_BOT_TOKEN=

# --- SERVER-SERVER kaliti (auth-2) ---
# ERP <-> Tender-AI chaqiruvlari uchun; ikkala loyihada BIR XIL bo'lsin.
# Yangisini yaratish:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ERP_SERVICE_KEY=

# --- Cookie (auth-4) ---
# Sessiya tokeni HttpOnly cookie'da. `Secure` bayrog'i cookie'ni faqat
# HTTPS orqali yuboradi; brauzerlar `localhost` ni ishonchli deb
# hisoblaydi, shuning uchun ishlab chiqishda ham yoqiq qoladi.
# HTTP orqali BOSHQA manzilda (masalan 192.168.x.x) ochsangiz - 0 qiling,
# aks holda brauzer cookie'ni saqlamaydi va kirish ishlamaydi.
AUTH_COOKIE_SECURE=1

# --- Parol tanlashdan himoya (auth-5) ---
# Raqamlar ERP dagi bilan BIR XIL bo'lsin: ikki eshik bir xil qoida
# bilan qo'riqlanadi. Cheklov HISOBGA emas, (login + IP) juftligiga
# tegadi va VAQTINCHA — kompaniya hisobi bitta, uni yopish butun
# kompaniyani tizimdan uzib qo'yardi.
AUTH_ATTEMPT_WINDOW_MIN=15
AUTH_MAX_ATTEMPTS=5
# Bitta IP dan HAMMA loginlar bo'yicha — nom aylantirishga qarshi.
AUTH_MAX_ATTEMPTS_IP=25
# Jurnal shuncha kundan keyin tozalanadi.
AUTH_ATTEMPT_KEEP_DAYS=90

# --- Parol talabi (auth-6) ---
# UZUNLIK talab qilinadi, "katta harf + raqam + belgi" EMAS: murakkablik
# qoidalari `Parol123!` ni keltirib chiqaradi va u monitorga
# yopishtiriladi. Uzun sodda ibora ancha kuchli va yodda qoladi.
AUTH_PASSWORD_MIN=10

# --- Proksi orqasida ishlaganda (auth-5) ---
# Default O'CHIQ. Yoqilsa, mijoz manzili `X-Forwarded-For` ning OXIRGI
# qiymatidan olinadi — uni bizga eng yaqin (ishonchli) proksi qo'yadi.
# Boshidagi qiymatlarni mijozning o'zi yozib yuborishi mumkin, shuning
# uchun ular ISHLATILMAYDI.
# FAQAT nginx/IIS kabi teskari proksi ortida yoqing: to'g'ridan-to'g'ri
# ochiq turgan serverda buni yoqish parol himoyasining IP cheklovini
# chetlab o'tishga yo'l ochadi.
TRUST_PROXY=0

# =====================================================================
# PULLIK AI CHAQIRUVLARI — STANDART HOLAT: O'CHIRILGAN
# =====================================================================
# Loyiha ishlab chiqarish holatiga chiqmaguncha HECH QANDAY pullik
# amal bajarilmaydi (chat, Go/No-Go, moslik tahlili, LLM bilan talab
# ajratish, eval).
#
# Bu qulf KODDA: `api/ai.paid_guard()`. Uni yoqmasdan turib pullik
# chaqiruv qilib bo'lmaydi — tasodifan ham.
#
# BLOKLANMAYDIGANLAR (ular pul sarflamaydi):
#   - lokal embedding (multilingual-e5-small)
#   - naqsh bilan talab ajratish
#   - retrieval, ETL, hujjat matni
AI_PAID_ENABLED=0
