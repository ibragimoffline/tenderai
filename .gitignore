# ===== Maxfiy — HECH QACHON push qilinmaydi =====
# Chiziqchasiz naqsh HAR QANDAY chuqurlikda mos keladi: `.env` ham,
# `frontend/.env` ham, `api/.env` ham shu bitta qator bilan yopiladi.
.env
# ngrok tunnel ta'rifi - ichida tunnel PAROLI (traffic policy basic-auth) bor.
ngrok.yml
# Asboblar yasaydigan variantlar: Vite `.env.local` va `.env.production` ni
# o'zi o'qiydi, ba'zi muharrirlar `.env.bak` qoldiradi. Ular `.env` naqshiga
# TUSHMAYDI — shuning uchun alohida yoziladi.
.env.*
# Namunalar SIR EMAS va push qilinadi. Istisnolar `.env.*` dan KEYIN turishi
# SHART: git naqshlarni tartib bo'yicha qo'llaydi, oxirgi moslik g'olib.
!.env.example
!.env*.example

# ===== Python =====
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# ===== Node / frontend =====
node_modules/
dist/
*.local

# ===== Loglar / vaqtinchalik / zaxira =====
*.log
etl_cron.log
*.tsv
# Migratsiya manifesti — `*.tsv` ga tushib qolgan edi, lekin u LOG EMAS,
# MANBA: 55 ta migratsiyaning muzlatilgan tartibi. Kuzatilmasa toza
# klonda `migratsiya.py` umuman ishlamasdi ("Manifest YO'Q") va buni
# hech narsa ko'rsatmasdi.
!migratsiya_manifest.tsv
*.bak
.tmp/
.runtime/

# Joylashtirish muhit fayllari — SIR SAQLAYDI (DSN paroli, SMTP,
# Telegram tokeni). Faqat `*.example` namunalari kuzatiladi.
deploy/env/*.env
!deploy/env/*.env.example

# ===== OS / muharrir =====
.DS_Store
.idea/
.vscode/
*.swp
*.dump
_pgvector/

# ETL operatsion holati — kodga aloqasi yo'q, mashinaga xos
.etl_embed_otkazish.json

# TypeScript inkremental qurish keshi — mashinaga xos, kodga aloqasi yo'q
*.tsbuildinfo

# Sinov fixture'lari — `_tests/import_test.py:make_fixtures()` HAR YURISHDA
# qayta yasaydi. Kuzatilganda `.xlsx` ichidagi yaratilish vaqti tufayli
# ishchi daraxt har sinovdan keyin "iflos" bo'lardi (o'lchangan: faqat
# `docProps/core.xml` farq qiladi, mazmun bir xil). Ular manba emas —
# qurish artefakti. Sinov ularsiz ham to'liq yuradi (tekshirilgan).
_tests/fixtures/*.xlsx
_tests/fixtures/*.csv

# Sinov yurgizuvchisi saqlaydigan to'liq chiqishlar va JSON xulosa.
# Bular ARTEFAKT, manba emas: har yurishda qayta yoziladi.
_test_natija/
