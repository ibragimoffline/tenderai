#!/usr/bin/env bash
# =============================================================================
# TENDER-AI — ZAXIRANING TASHQI NUSXASI (belgilangan o'rama)
# =============================================================================
#     /usr/local/sbin/tender-backup-remote <fayl>
#
# `backup.sh` uni SHUNDAY chaqiradi:
#     BACKUP_REMOTE_CMD='/usr/local/sbin/tender-backup-remote {fayl}'
#
# --- NEGA O'RAMA, "BUYRUQ SHABLONI" EMAS -------------------------------------
# Ilgari `BACKUP_REMOTE_CMD` ixtiyoriy qobiq satri edi va u `eval`
# bilan yurardi. Ikkita muammo:
#
#   1. `eval` -- butun satr qobiq sifatida o'qilardi. Zaxira yo'li
#      root nomidan yuriydi, ya'ni bu eng qimmat joyda eng keng
#      imkoniyat edi.
#   2. Manzil va kalit MUHIT FAYLIDA turardi. Muhit fayli ilova
#      uchun ham o'qiladi, ya'ni zaxira omborining kaliti kerak
#      bo'lmagan joyda ko'rinardi.
#
# Endi manzil va kalit FAQAT shu o'rama o'qiydigan `0600 root:root`
# faylda. Muhit faylida esa faqat o'rama YO'LI turadi -- u sir emas.
#
# --- YOPIQ SHARTNOMA ---------------------------------------------------------
# BITTA argument: nusxalanadigan fayl. Boshqa hech narsa uzatilmaydi.
# `"$@"` HECH QAYERGA yo'naltirilmaydi -- umumiy o'tkazgich yo'q.
#
# --- YOZISH, O'CHIRISH EMAS --------------------------------------------------
# O'rama uzoqda HECH NARSA O'CHIRMAYDI. Sabab: manba mezbon buzilgan
# holatda (shifrlovchi dastur, buzilgan hisob) o'chirish huquqi
# zaxirani ham yo'q qiladi. Saqlash muddati UZOQ tomonda
# boshqariladi -- boshqa hisob, boshqa kalit bilan.
#
# --- BUTUNLIK UZOQDA TEKSHIRILADI --------------------------------------------
# "Nusxa ko'chdi" degan xulosa "nusxa BUTUN" degani emas: uzilgan
# o'tkazma ham 0 qaytarishi mumkin. Shuning uchun nusxadan keyin
# uzoqdagi nusxaning sha256 i o'qiladi va MAHALLIY bilan
# solishtiriladi. Farq bo'lsa -- XATO.
#
# --- IKKI USUL, BITTA SHARTNOMA ----------------------------------------------
# `USUL=ssh` -- ikkinchi Linux mezbon (scp + uzoqda `sha256sum`).
# `USUL=s3`  -- S3 ga mos ombor (`rclone`; B2, R2, Hetzner, AWS).
#
# NEGA BITTA SKRIPT, IKKITA EMAS. Xavfsizlik-kritik qism -- argument
# validatsiyasi (mutlaq yo'l, `..` yo'q, manba ildizi ichida, tor
# alifbo). Ikki nusxada u ASTA-SEKIN AJRALARDI va bittasida yopilgan
# teshik ikkinchisida ochiq qolardi. Shuning uchun tekshiruv BITTA
# joyda, faqat O'TKAZMA usuli ajraladi.
#
# `s3` uchun `rclone` KERAK va u ataylab OLDINDAN O'RNATILMAYDI:
# manzil tanlanmagan bo'lsa vosita ham kerak emas.
# =============================================================================
set -euo pipefail

SOZLAMA="${TENDER_BACKUP_REMOTE_CONF:-/etc/tenderai/backup-remote.conf}"
#: Ruxsat etilgan MANBA ildizi. Boshqa joydan fayl yuborilmaydi:
#: o'rama root nomidan yuradi va "istalgan faylni uzoqqa ko'chir"
#: degan imkoniyat ma'lumot chiqarish yo'liga aylanardi.
MANBA_ILDIZ="${TENDER_BACKUP_ILDIZ:-/var/backups/tenderai}"

log()  { printf '[%s] tender-backup-remote: %s\n' "$(date '+%F %T')" "$*"; }
xato() { printf '[%s] tender-backup-remote XATO: %s\n' "$(date '+%F %T')" "$*" >&2; exit 1; }

[ "$(id -u)" = "0" ] || xato "root kerak."


# --- 2) SOZLAMA ---------------------------------------------------------------
sozlama_yukla() {
[ -f "$SOZLAMA" ] || xato "sozlama YO'Q: $SOZLAMA
   Namuna: deploy/env/backup-remote.conf.example"
REJIM="$(stat -c '%a' "$SOZLAMA")"
EGA="$(stat -c '%U' "$SOZLAMA")"
[ "$EGA" = "root" ] || xato "$SOZLAMA egasi '$EGA' — root bo'lishi kerak"
case "$REJIM" in
    600|400) ;;
    *) xato "$SOZLAMA rejimi $REJIM — 600 bo'lishi kerak (ichida kalit yo'li bor)" ;;
esac
# shellcheck disable=SC1090
. "$SOZLAMA"

USUL="${USUL:-ssh}"
case "$USUL" in ssh|s3) ;; *) xato "USUL '$USUL' noma'lum — 'ssh' yoki 's3'" ;; esac
}

# --- S3 MUHITI — KALITLAR BITTA JOYDA -----------------------------------------
# Yuklash ham, o'qish ham AYNI sozlashdan foydalanadi. Ikkinchi
# nusxa yasash kalit ishlashini ikki joyda tutishni talab qilardi
# va ular ASTA-SEKIN ajralardi.
s3_muhit() {
    for k in S3_ENDPOINT S3_BUCKET S3_ACCESS_KEY_ID S3_SECRET_ACCESS_KEY; do
        eval "v=\${${k}:-}"
        [ -n "$v" ] || xato "$SOZLAMA da '$k' bo'sh (USUL=s3)"
    done
    RCLONE="${RCLONE_BIN:-rclone}"
    command -v "$RCLONE" >/dev/null \
        || xato "\`$RCLONE\` topilmadi. USUL=s3 uchun rclone kerak.
   O'rnating: apt-get install -y rclone"
    case "$S3_ENDPOINT" in
        https://*) ;;
        *) xato "S3_ENDPOINT HTTPS emas: shifrlanmagan kanal orqali
   zaxira yuborilmaydi." ;;
    esac
    R=ZAXIRA
    export RCLONE_CONFIG="/dev/null"
    export RCLONE_CONFIG_${R}_TYPE="s3"
    export RCLONE_CONFIG_${R}_PROVIDER="${S3_PROVIDER:-Other}"
    export RCLONE_CONFIG_${R}_ENDPOINT="$S3_ENDPOINT"
    export RCLONE_CONFIG_${R}_REGION="${S3_REGION:-}"
    export RCLONE_CONFIG_${R}_ACCESS_KEY_ID="$S3_ACCESS_KEY_ID"
    export RCLONE_CONFIG_${R}_SECRET_ACCESS_KEY="$S3_SECRET_ACCESS_KEY"
    RC=("$RCLONE" --retries 3 --low-level-retries 5)
}

#: Ruxsat etilgan turlar — YOPIQ ro'yxat, yuklash va o'qish uchun bir xil.
TURLAR="db uploads meta checksums zond"
tur_tekshir() {
    for t in $TURLAR; do [ "$1" = "$t" ] && return 0; done
    xato "tur noma'lum: '$1' (ruxsat: $TURLAR)"
}
muhit_tekshir() {
    case "$1" in staging|production) ;; *) xato "muhit noma'lum: '$1'" ;; esac
}
nom_tekshir() {
    case "$1" in
        *[!A-Za-z0-9._-]*|""|.|..) xato "fayl nomi yaroqsiz: '$1'" ;;
    esac
}
s3_prefiks() { printf '%s/%s/%s/%s' "${S3_BUCKET%/}" "${S3_PREFIX:-tenderai}" "$1" "$2"; }

# --- O'QISH AMALLARI — YOPIQ RO'YXAT ------------------------------------------
# NEGA O'RAMADA. Uzoqdan tiklash uchun obyektlarni QAYTARIB OLISH
# kerak. Buni alohida skript qilsak, u kalitlarni O'ZI o'qishi va
# rclone ni O'ZI sozlashi kerak bo'lardi -- ya'ni ikkinchi sir
# ishlovchisi. Bitta tor interfeys ikkitadan xavfsizroq.
#
# UMUMIY O'TKAZGICH YO'Q: amallar sanab o'tilgan, har argument
# tekshiriladi, `"$@"` hech qayerga uzatilmaydi.
case "${1:-}" in
--royxat)
    [ "$#" -eq 3 ] || xato "--royxat <muhit> <tur>"
    muhit_tekshir "$2"; tur_tekshir "$3"
    sozlama_yukla
    [ "$USUL" = "s3" ] || xato "--royxat faqat USUL=s3 uchun"
    s3_muhit
    "${RC[@]}" lsf -R -- "${R}:$(s3_prefiks "$2" "$3")" 2>/dev/null || true
    exit 0
    ;;
--olib-kel)
    [ "$#" -eq 5 ] || xato "--olib-kel <muhit> <tur> <nom> <maqsad-katalog>"
    muhit_tekshir "$2"; tur_tekshir "$3"; nom_tekshir "$4"
    MAQSAD="$5"
    case "$MAQSAD" in /*) ;; *) xato "maqsad MUTLAQ yo'l bo'lsin" ;; esac
    case "$MAQSAD" in *..*) xato "maqsadda '..' bor" ;; esac
    TIKLASH_ILDIZ="${TENDER_TIKLASH_ILDIZ:-/var/tmp/tenderai-tiklash}"
    HM="$(readlink -f "$MAQSAD" 2>/dev/null || true)"
    [ -n "$HM" ] && [ -d "$HM" ] || xato "maqsad katalogi yo'q: $MAQSAD"
    case "$HM/" in
        "${TIKLASH_ILDIZ%/}"/*) ;;
        *) xato "maqsad '${TIKLASH_ILDIZ}' ichida emas: $HM
   Uzoqdan olib kelingan fayl FAQAT ajratilgan tiklash katalogiga
   tushadi -- zaxira katalogiga emas, reliz daraxtiga emas." ;;
    esac
    sozlama_yukla
    [ "$USUL" = "s3" ] || xato "--olib-kel faqat USUL=s3 uchun"
    s3_muhit
    # Sana kataloglari bo'ylab qidiramiz: kalit `<tur>/YYYY/MM/DD/<nom>`.
    YOL="$("${RC[@]}" lsf -R --files-only -- "${R}:$(s3_prefiks "$2" "$3")" 2>/dev/null \
           | grep -F -- "/$4" | head -1 || true)"
    [ -n "$YOL" ] || xato "uzoqda topilmadi: $2/$3/$4"
    "${RC[@]}" copyto -- "${R}:$(s3_prefiks "$2" "$3")/${YOL}" "${HM}/$4" >/dev/null \
        || xato "olib kelinmadi: $YOL"
    printf '%s\n' "$(s3_prefiks "$2" "$3")/${YOL}"
    exit 0
    ;;
esac

# --- 1) ARGUMENT — QAT'IY -----------------------------------------------------
[ "$#" -eq 1 ] || xato "aynan BITTA argument kerak (fayl yo'li). Berilgan: $#"
FAYL="$1"

case "$FAYL" in
    /*) ;;
    *)  xato "yo'l MUTLAQ bo'lishi kerak: '$FAYL'" ;;
esac
case "$FAYL" in
    *..*) xato "yo'lda '..' bor: '$FAYL'" ;;
esac
# MANBA ILDIZI ICHIDA bo'lsin. `readlink -f` simlink orqali
# chiqib ketishni ham yopadi.
HAQIQIY="$(readlink -f "$FAYL" 2>/dev/null || true)"
[ -n "$HAQIQIY" ] || xato "yo'l aniqlanmadi: '$FAYL'"
case "$HAQIQIY/" in
    "${MANBA_ILDIZ%/}"/*) ;;
    *) xato "fayl '${MANBA_ILDIZ}' ichida emas: $HAQIQIY" ;;
esac
[ -f "$HAQIQIY" ] || xato "oddiy fayl emas: $HAQIQIY"
[ -r "$HAQIQIY" ] || xato "o'qilmaydi: $HAQIQIY"

# FAYL NOMI — TOR ALIFBO. Nom uzoq tomonda buyruq qatoriga tushadi,
# shuning uchun metabelgi UMUMAN bo'lmasin.
NOM="$(basename "$HAQIQIY")"
case "$NOM" in
    *[!A-Za-z0-9._-]*) xato "fayl nomida ruxsatsiz belgi: '$NOM'" ;;
    ""|.|..)           xato "fayl nomi yaroqsiz" ;;
esac



sozlama_yukla

# Sana bo'yicha prefiks: uzoq tomonda saqlash muddatini qo'llash
# oson bo'lsin va bitta katalog cheksiz o'smasin.
SANA="$(date '+%Y/%m/%d')"
MAHALLIY_SHA="$(sha256sum "$HAQIQIY" | cut -d' ' -f1)"

if [ "$USUL" = "ssh" ]; then
    for k in UZOQ_HOST UZOQ_USER UZOQ_YOL SSH_KALIT; do
        eval "v=\${${k}:-}"
        [ -n "$v" ] || xato "$SOZLAMA da '$k' bo'sh (USUL=ssh)"
    done
    UZOQ_PORT="${UZOQ_PORT:-22}"
    BILINGAN="${SSH_KNOWN_HOSTS:-/etc/tenderai/backup-known_hosts}"

    [ -f "$SSH_KALIT" ] || xato "SSH kaliti yo'q: $SSH_KALIT"
    K_REJIM="$(stat -c '%a' "$SSH_KALIT")"
    case "$K_REJIM" in
        600|400) ;;
        *) xato "SSH kaliti rejimi $K_REJIM — 600 bo'lishi kerak" ;;
    esac
    # MEZBON KALITI OLDINDAN ISHONILGAN BO'LSIN.
    # `StrictHostKeyChecking` o'chirilsa, o'rtadagi odam zaxirani
    # qabul qilib olardi va biz buni BILMASDIK.
    [ -s "$BILINGAN" ] || xato "known_hosts YO'Q yoki bo'sh: $BILINGAN
   To'ldiring: ssh-keyscan -p ${UZOQ_PORT} <host> > $BILINGAN"

    SSH_ARG=(-i "$SSH_KALIT" -p "$UZOQ_PORT"
             -o BatchMode=yes
             -o StrictHostKeyChecking=yes
             -o UserKnownHostsFile="$BILINGAN"
             -o IdentitiesOnly=yes
             -o ConnectTimeout=20)

    MAQSAD="${UZOQ_YOL%/}/${SANA}"
    UZOQ="${UZOQ_USER}@${UZOQ_HOST}"
    log "manzil: ssh ${UZOQ}:${MAQSAD}/${NOM}"
    ssh "${SSH_ARG[@]}" "$UZOQ" "mkdir -p -- '${MAQSAD}'" \
        || xato "uzoqda katalog yasalmadi (kalit yoki huquq?)"
    scp "${SSH_ARG[@]}" -p -- "$HAQIQIY" "${UZOQ}:${MAQSAD}/${NOM}" >/dev/null \
        || xato "nusxa ko'chmadi"

    # BUTUNLIK UZOQDA HISOBLANADI: baytlar o'sha yerda o'qiladi,
    # ya'ni "yozildi" emas, "SAQLANDI" isbotlanadi.
    UZOQ_SHA="$(ssh "${SSH_ARG[@]}" "$UZOQ" \
        "sha256sum -- '${MAQSAD}/${NOM}' 2>/dev/null | cut -d' ' -f1" || true)"
else
    # --- S3 GA MOS OMBOR (Backblaze B2 va boshqalar) --------------------
    # Kalit sozlash `s3_muhit()` da -- yuklash va o'qish AYNI
    # joydan foydalanadi. Ilgari bu yerda TAKRORLANGAN nusxa turardi
    # va ikki nusxa asta-sekin ajralardi.
    s3_muhit

    # --- OBYEKT KALITI — TUR BO'YICHA AJRATILGAN -----------------------
    # Nega tekis emas: saqlash muddati (lifecycle) qoidalari TURGA
    # qarab boshqacha bo'ladi -- dump va fayl arxivi og'ir, meta va
    # checksum yengil. Bitta katalogda ular bir-biridan ajralmasdi.
    #
    # Tur FAYL NOMIDAN aniqlanadi va NOMA'LUM tur RAD ETILADI:
    # o'rama interfeysi tor bo'lib qolsin. Yangi artefakt qo'shilsa
    # bu yerda ATAYLAB e'lon qilinadi.
    case "$NOM" in
        *.sha256)          TUR="checksums" ;;
        *-meta.json|*-meta.txt) TUR="meta" ;;
        *-fayllar.tar.gz)  TUR="uploads" ;;
        *.dump)            TUR="db" ;;
        # ZOND — ulanish shartnomasini AYNI YO'L bilan sinash uchun.
        # Yon kanal bilan sinash (rclone ni to'g'ridan chaqirish)
        # haqiqiy yo'lni isbotlamasdi: kalitlar boshqacha
        # uzatilardi, kalit sxemasi boshqacha yasalardi va
        # butunlik boshqacha tekshirilardi.
        *-zond.txt)        TUR="zond" ;;
        *) xato "fayl turi NOMA'LUM: '$NOM'
   O'rama faqat e'lon qilingan turlarni yuboradi (db, uploads,
   meta, checksums). Yangi turni shu yerda e'lon qiling." ;;
    esac
    # Muhit KATALOG nomidan olinadi (fayl nomidan emas): katalog
    # `backup.sh` yozadigan joy va uni chalkashtirib bo'lmaydi.
    MUHIT_NOM="$(basename "$(dirname "$HAQIQIY")")"
    PREFIKS="${S3_PREFIX:-tenderai}"
    OBYEKT="${S3_BUCKET%/}/${PREFIKS%/}/${MUHIT_NOM}/${TUR}/${SANA}/${NOM}"
    MANZIL="${R}:${OBYEKT}"
    log "manzil: s3 ${S3_ENDPOINT} -> ${OBYEKT}"
    RC=("$RCLONE" --retries 3 --low-level-retries 5)
    # NOSOZLIK QATLAMGA AJRATILADI.
    #
    # Ilgari xabar "(kalit, chelak yoki huquq?)" edi -- ya'ni
    # TAXMIN. O'lchangan holatda esa sabab DNS edi va bu ro'yxatda
    # umuman yo'q edi: operator kalitni qidirib vaqt yo'qotardi.
    # `rclone` ning o'z xatosi sababni aytadi, uni o'qish kerak.
    RC_XATO="$(mktemp)"
    if ! "${RC[@]}" copyto -- "$HAQIQIY" "$MANZIL" >/dev/null 2>"$RC_XATO"; then
        SABAB="$(tr -d '\r' < "$RC_XATO" | grep -viE '^[0-9/: ]*(ERROR|NOTICE)' \
                 | grep -v '^$' | head -2)"
        [ -n "$SABAB" ] || SABAB="$(head -2 "$RC_XATO")"
        QATLAM="OTHER"
        case "$SABAB" in
            *"no such host"*|*"lookup "*|*"DNS"*)          QATLAM="DNS" ;;
            *x509*|*certificate*|*"tls:"*|*TLS*)           QATLAM="TLS" ;;
            *InvalidAccessKeyId*|*SignatureDoesNotMatch*|*"401 "*|*Unauthorized*)
                                                          QATLAM="AUTH" ;;
            *NoSuchBucket*|*"bucket"*"not"*"exist"*)       QATLAM="BUCKET" ;;
            *AccessDenied*|*"403 "*|*"not authorized"*)    QATLAM="PERMISSION" ;;
            *"connection refused"*|*timeout*|*"i/o timeout"*) QATLAM="NETWORK" ;;
        esac
        rm -f "$RC_XATO"
        xato "nusxa ko'chmadi — QATLAM: ${QATLAM}
   ${SABAB}"
    fi
    rm -f "$RC_XATO"

    # BUTUNLIK: obyekt QAYTA O'QILADI va hash MAHALLIY hisoblanadi.
    #
    # ETag/MD5 GA TAYANILMAYDI: ko'p qismli yuklashda ETag faylning
    # sha256 i EMAS va provayderlar orasida farq qiladi. B2 esa
    # o'z SHA1 ini beradi -- u ham bizniki emas. Qayta o'qish
    # "uzoqdan olib kelish" ni ham bajaradi, ya'ni bitta amal ikki
    # narsani isbotlaydi: obyekt BOR va baytlar BUTUN.
    UZOQ_SHA="$("${RC[@]}" cat -- "$MANZIL" 2>/dev/null | sha256sum | cut -d' ' -f1 || true)"
fi

# --- 4) BUTUNLIK — SOLISHTIRISH ----------------------------------------------
[ -n "$UZOQ_SHA" ] || xato "uzoqdagi nusxa O'QILMADI — nusxa tasdiqlanmadi"
[ "$UZOQ_SHA" = "$MAHALLIY_SHA" ] || xato "CHECKSUM MOS EMAS:
   mahalliy: $MAHALLIY_SHA
   uzoq    : $UZOQ_SHA
   Nusxa BUZUQ — zaxira himoyalangan deb hisoblanmasin."

log "OK: ${NOM} (${MAHALLIY_SHA:0:16}…) ${USUL} orqali tasdiqlandi"
