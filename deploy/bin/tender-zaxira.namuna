#!/usr/bin/env bash
# =============================================================================
# TENDER-AI — ZAXIRA O'RAMASI (NOPASSWD sudo uchun)
# =============================================================================
#     sudo tender-zaxira <amal> <staging|production>
#
#     sozlama       — tashqi manzil sozlamasi TO'LIQMI (qiymatsiz)
#     zond          — kichik sun'iy obyekt bilan ulanishni sinash
#     zaxira        — YANGI zaxira olish va uzoqqa yuborish
#     tiklash-uzoq  — UZOQDAN olib kelib, ajratilgan bazaga tiklash
#     holat         — baza holati (faqat o'qish)
#
# --- NEGA O'RAMA ------------------------------------------------------------
# Bu amallarning hammasi root talab qiladi: muhit fayllari
# `0640 root:tenderai`, zaxira katalogi `0700`, tiklash esa baza
# yaratadi. Har qadamda operatorni buyruq nusxalashga majburlash
# zanjirni uzadi va xato nusxalash ehtimolini oshiradi.
#
# --- YOPIQ RO'YXAT ----------------------------------------------------------
# Amallar SANAB O'TILGAN. `"$@"` hech qayerga uzatilmaydi, qobiq
# satri qabul qilinmaydi, ixtiyoriy skript nomi berilmaydi.
# Muhit ham ikkitadan biri.
#
# --- KOD KO'ZGUDAN OLINADI --------------------------------------------------
# Skriptlar ish nusxasidan EMAS, o'zgarmas bare repodan olinadi --
# ya'ni yurgizilgan kod AYNIQSA qaysi kommit ekani aniq. Bu
# `tender-darvoza` va `tender-darvoza-docker` bilan bir xil idioma.
#
# --- NIMA QILMAYDI ----------------------------------------------------------
# Joylashtirmaydi. Migratsiya qo'llamaydi. Production bazasiga
# YOZMAYDI (`holat` va `tiklash-uzoq` faqat o'qiydi; tiklash
# ALOHIDA sinov bazasiga boradi). Uzoqda hech narsa o'chirmaydi.
# =============================================================================
set -euo pipefail

AMAL="${1:?foydalanish: tender-zaxira <sozlama|zond|zaxira|tiklash-uzoq|holat> <staging|production>}"
MUHIT="${2:?muhit kerak: staging yoki production}"
[ "$#" -eq 2 ] || { echo "aynan IKKITA argument kerak. Berilgan: $#" >&2; exit 2; }

case "$AMAL" in
    sozlama|zond|zaxira|tiklash-uzoq|holat) ;;
    *) echo "Noma'lum amal: '$AMAL'" >&2
       echo "Ruxsat: sozlama | zond | zaxira | tiklash-uzoq | holat" >&2
       exit 2 ;;
esac
case "$MUHIT" in staging|production) ;; *) echo "Noma'lum muhit: '$MUHIT'" >&2; exit 2 ;; esac
[ "$(id -u)" = "0" ] || { echo "root kerak: sudo $0 $AMAL $MUHIT" >&2; exit 1; }

REPO=/opt/tenderai/repo.git
REF="${TENDERAI_REF:-main}"
log() { printf '[%s] %s\n' "$(date '+%F %T')" "$*"; }

VAQT="$(mktemp -d)"
trap 'rm -rf "$VAQT"' EXIT
KOMMIT="$(sudo -u tenderai git --git-dir="$REPO" rev-parse --short "$REF")" \
    || { echo "ref topilmadi: $REF" >&2; exit 1; }
sudo -u tenderai git --git-dir="$REPO" archive "$REF" deploy | tar -x -C "$VAQT"
log "kod: $REF ($KOMMIT)"

B="${VAQT}/deploy/bin"
chmod +x "$B"/*.sh 2>/dev/null || true

case "$AMAL" in
sozlama)      exec "$B/zaxira-uzoq-sinov.sh" "$MUHIT" --sozlama ;;
zond)         exec "$B/zaxira-uzoq-sinov.sh" "$MUHIT" ;;
holat)        exec "$B/baza-holat.sh" "$MUHIT" ;;
tiklash-uzoq) exec "$B/uzoqdan-tiklash.sh" "$MUHIT" ;;
zaxira)
    # ZAXIRA XIZMAT NOMIDAN, LEKIN KO'ZGUDAGI KOD BILAN.
    #
    # `systemctl start tenderai-backup@...` RELIZDAGI `backup.sh`
    # ni yurgizadi. Production relizi eski bo'lsa (hozir 5-sentabr)
    # u ILOVA roli bilan dump oladi va tiklash metasini umuman
    # yozmaydi -- ya'ni zaxira olinardi, lekin u kutilgan zaxira
    # BO'LMASDI.
    #
    # `backup.sh` -- xizmatning O'ZI emas, TEXNIK XIZMAT asbobi.
    # Uni ko'zgudan yurgizish relizni o'zgartirmaydi va
    # joylashtiruv HISOBLANMAYDI.
    #
    # FOYDALANUVCHI O'ZGARMAYDI: `tenderai` nomidan yuriladi --
    # aynan timer kabi. Root nomidan yurgizsak fayl egaligi
    # boshqacha chiqib, keyingi timer o'z fayllariga tega
    # olmasligi mumkin edi.
    log "zaxira olinmoqda (ko'zgudagi kod, xizmat nomidan)"
    exec sudo -u tenderai -H "$B/backup.sh" "$MUHIT"
    ;;
esac
