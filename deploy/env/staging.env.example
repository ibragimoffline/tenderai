# =============================================================================
# Tender AI — STAGING muhiti
# =============================================================================
# JOYLASHUVI:  /etc/tenderai/staging.env
# HUQUQLARI:   chown root:tenderai  &&  chmod 0640
#
# BU FAYL NAMUNA. HAQIQIY QIYMATLAR REPOZITORIYAGA TUSHMAYDI —
# `.gitignore` `deploy/env/*.env` ni chetlatadi, faqat `*.example`
# kuzatiladi.
# =============================================================================

APP_ENV=staging

# --- Tarmoq -----------------------------------------------------------------
# Caddyfile dagi `reverse_proxy 127.0.0.1:8001` bilan MOS bo'lsin.
API_PORT=8001
API_WORKERS=2

# Proksi ORTIDA: haqiqiy IP `X-Forwarded-For` dan olinadi.
TRUST_PROXY=1
AUTH_COOKIE_SECURE=1

# HSTS ni CADDY qo'yadi (TLS terminatorining ishi) — bu yerda 0.
HSTS_MAX_AGE=0

# Swagger STAGING da ochiq bo'lishi mumkin (u basic_auth ortida).
API_DOCS=1

# Same-origin: frontend va API bitta domen ostida (`/api/*`).
CORS_ORIGINS=

# --- OMMAVIY MANZIL (MAJBURIY) ----------------------------------------------
# Bildirishnoma havolalari (email, Telegram) SHUNDAN quriladi —
# `api/ommaviy_url.py`, YAGONA manba.
#
# BERILMASA yoki mahalliy manzil bo'lsa xizmat UMUMAN ISHGA
# TUSHMAYDI (`ommaviy_url.ishga_tushishda_tekshir()`). Ilgari
# tekshiruv faqat yuborish paytida edi va noto'g'ri sozlama
# soatlar keyin, ETL jurnalida ko'rinardi.
APP_PUBLIC_URL=https://staging.example.uz
#
# ESKI NOM (14-vazifa). Hali ishlaydi, lekin ogohlantirish
# yozadi. IKKALASI ham berilib, qiymatlari BOSHQA bo'lsa —
# xizmat ishga tushmaydi: qaysi biri to'g'ri ekanini taxmin
# qilib bo'lmaydi.
# PUBLIC_BASE_URL=

# --- FRONTEND QURILMASI (ommaviy — sir BO'LMASIN) ---------------------------
# `VITE_*` qiymatlari ta'rifi bo'yicha brauzerga tushadi.
# `deploy.sh` ularni `frontend/.env.production` ga yozadi.
#
# `/api` NISBIY bo'lishi SHART: sessiya cookie'si `SameSite=Lax`
# va u faqat same-origin so'rovda ketadi. To'liq manzil yozilsa
# qurilma qo'rovuli uni TO'XTATADI (`frontend/vite.config.ts`).
VITE_API_BASE=/api
# ERP interfeysiga havola — ixtiyoriy. Berilmasa ERP bloki
# ko'rinmaydi. Mahalliy manzil bo'lsa qurilma yiqiladi.
VITE_ERP_WEB=

# --- Baza -------------------------------------------------------------------
# ENG KAM HUQUQLI rol (`schema_patch_huquq.sql`, `tai_app`).
# Migratsiyalar BOSHQA rol bilan yuriladi — `docs/deploy.md` §6.
# TIRNOQ SHART — ichida BO'SHLIQ bor.
#
# O'LCHANGAN NUQSON (2026-09-01, B-1). Bu qiymat TIRNOQSIZ edi va
# u IKKI XIL o'qilardi:
#
#   systemd `EnvironmentFile=`  butun qatorni oladi   -> TO'G'RI
#   shell `. envfile`           BIRINCHI bo'shliqda   -> BUZILADI
#                               kesadi
#
# Ya'ni API xizmati to'g'ri DSN olardi, `backup.sh` /
# `restore-test.sh` / `deploy.sh` esa `dbname=tenderai_staging`
# ni — user, parol va host YO'QOLGAN holda. Qolgani (`user=...`)
# shellda O'ZGARUVCHI TAYINLASH bo'lib ketardi, ya'ni XATO HAM
# BERMASDI — zaxira boshqa foydalanuvchi bilan, boshqa hostga
# ulanishga urinardi va buni hech narsa ko'rsatmasdi.
#
# Bu skriptlar HECH QACHON yurgizilmagani uchun payqalmagan.
# Mashq qilinganda BIRINCHI qadamdayoq chiqdi.
XT_DB_DSN="dbname=tenderai_staging user=tai_service password=REPLACE host=127.0.0.1 port=5432"

# MIGRATSIYA va TIKLASH MASHQI uchun EGASI roli. `deploy.sh` va
# `restore-test.sh` uni TALAB qiladi (`:?`), lekin bu namunada u
# YO'Q edi — ya'ni namunaga qarab tayyorlangan server birinchi
# joylashtirishda to'xtardi.
#
# Ilova roli (`tai_service`) da DDL huquqi ATAYLAB yo'q —
# `docs/xavfsizlik.md` C-1.
XT_DB_DSN_OWNER="dbname=tenderai_staging user=postgres password=REPLACE host=127.0.0.1 port=5432"
DB_POOL_MIN=1
DB_POOL_MAX=8

# --- ETL --------------------------------------------------------------------
# Timer soatiga bir marta uradi; ilova SHU byudjetda toza to'xtaydi.
ETL_MAX_SECONDS=1500

# --- Jurnal -----------------------------------------------------------------
LOG_FORMAT=json
LOG_LEVEL=INFO

# --- Embedding (LOKAL — tashqariga matn yubormaydi) --------------------------
# `1` bo'lsa `deploy.sh` har relizda `requirements-embed.txt` ni ham
# o'rnatadi (torch CPU + sentence-transformers, venv ~100 MB dan
# ~1.5 GB ga). `EMBED_PROVIDER=local` da SHUSIZ model yuklanmaydi va
# chat leksik qidiruvga tushadi — xizmat yiqilmaydi, lekin semantik
# qidiruv ishlamaydi.
# DISK: har reliz o'z venv iga ega, oxirgi 5 tasi saqlanadi -> ~7 GB.
EMBED_INSTALL=0
EMBED_PROVIDER=local
EMBED_MODEL_PATH=intfloat/multilingual-e5-small
EMBED_THREADS=2
EMBED_PRELOAD=1
EMBED_BATCH=32
EMBED_MAX_SEQ=512
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- AI ---------------------------------------------------------------------
# PULLIK AI O'CHIQ. Yoqish ONGLI qaror (`docs/legal-data-map.md` §5.1).
AI_PAID_ENABLED=0
ANTHROPIC_API_KEY=
AI_CHAT_MODEL=claude-sonnet-5
AI_EFFORT=medium

# --- Bildirishnoma ----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1
TELEGRAM_BOT_TOKEN=

# --- ERP --------------------------------------------------------------------
ERP_SERVICE_KEY=
ERP_COMPANY_ID=

# --- Zaxira -----------------------------------------------------------------
BACKUP_DIR=/var/backups/tenderai
BACKUP_KEEP_DAYS=14

# --- TASHQI NUSXA (O-2) ------------------------------------------------------
# ZAXIRA BITTA DISKDA — ZAXIRA EMAS. Disk yo'qolsa (yoki shifrlovchi
# dastur tegsa) zaxira ham u bilan ketadi.
#
# BUYRUQ SHABLONI beriladi, "manzil" emas: nusxalash usuli har joyda
# boshqacha va manzilga qarab usulni taxmin qilish noto'g'ri buyruqni
# JIMGINA yurgizardi. `{fayl}` dump yo'liga almashadi; `.sha256` ham
# shu buyruq bilan ketadi.
#
#   BACKUP_REMOTE_CMD='rclone copy {fayl} uzoq:tenderai/'
#   BACKUP_REMOTE_CMD='aws s3 cp {fayl} s3://chelak/tenderai/'
#   BACKUP_REMOTE_CMD='rsync -a {fayl} zaxira@host:/srv/tenderai/'
#
# BO'SH QOLDIRILSA `backup.sh` OGOHLANTIRISH yozadi va davom etadi —
# jim qolmaydi. Sozlangan bo'lsa-yu nusxa yiqilsa, skript XATO bilan
# to'xtaydi: "zaxira bor" degan xulosa yolg'on bo'lib qolmasin.
#
# DIQQAT: tashqi nusxaning TIKLANISHI hali sinalmagan.
# `restore-test.sh` MAHALLIY fayldan tiklaydi.
BACKUP_REMOTE_CMD=

# --- NOSOZLIK OGOHLANTIRISHI (O-3) ------------------------------------------
# `systemd` xizmatni qayta ko'taradi, LEKIN BUNI HECH KIM BILMASDI.
# Endi `OnFailure=` operatorga xabar yuboradi va har 10 daqiqada
# sog'liq tekshiriladi (`tenderai-health@.timer`).
#
# IKKI QATLAM, IKKI XIL NOSOZLIK:
#   OnFailure   xizmat YIQILDI (krash, chiqish kodi != 0)
#   health      xizmat ko'tarilgan, LEKIN sog'lom emas
#               (migratsiya qo'llanmagan, baza yo'q, ETL to'xtagan)
#
# OPERATOR KANALI MIJOZ KANALIDAN ALOHIDA. Bildirishnoma
# obunachilari mijozlar; nosozlik xabari esa operatorga ketishi
# kerak. Aralashtirish mijozga texnik xabar yuborardi.
#
# Telegram: bot tokeni yuqoridagi `TELEGRAM_BOT_TOKEN` dan olinadi,
# chat esa ALOHIDA.
ALERT_TELEGRAM_CHAT=
# Email: SMTP rekvizitlari yuqoridagilardan olinadi.
ALERT_EMAIL=
#
# IKKALASI HAM BO'SH BO'LSA `ogohlantir.sh` buni `journald` ga
# BALAND OVOZDA yozadi — "nosozlik bor, xabar yo'q" holati
# ko'rinmasdan qolmasin.

# --- UCHIDAN-UCHIGA SINOV (staging DARVOZASI, majburiy) ---------------------
#
# `deploy.sh` staging da `.verified` YOZISHDAN OLDIN
# `deploy/bin/e2e-fayl.sh` ni yurgizadi. Bularsiz joylashtiruv
# TO'XTAYDI -- ataylab: `health-check.sh` faqat "xizmat javob
# beryaptimi" ni tekshiradi, fayl yuklash OQIMINI emas.
#
# HISOBLAR IKKITA BO'LISHI SHART: ijarachi chegarasi bitta hisob
# bilan O'LCHANMAYDI. Ular ODDIY kompaniya hisoblari, alohida
# huquq kerak emas.
#
# DIQQAT: `--ai` DOIM beriladi, ya'ni har staging joylashtiruvida
# BITTA pullik model chaqiruvi bo'ladi. Bu ataylab: iqtibos
# zanjiri (fayl -> bo'lak -> javob) eng qimmat invariant.
E2E_URL=https://staging.example.uz/api
E2E_LOGIN=
E2E_PAROL=
E2E_BEGONA_LOGIN=
E2E_BEGONA_PAROL=
